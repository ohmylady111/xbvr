FROM node:24-bookworm-slim AS ui
WORKDIR /src
COPY package.json yarn.lock ./
RUN npm install --package-lock=false
COPY ui ./ui
RUN node --test ui/tests/*.test.cjs && npm run build

FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=ui /src/ui/dist ./ui/dist
ARG VERSION=zh-cn
ARG COMMIT=unknown
RUN CGO_ENABLED=1 go build -trimpath -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.branch=feat/zh-cn-ui" -o /out/xbvr .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 ffmpeg tzdata curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/xbvr /usr/bin/xbvr
COPY xbvr_data /usr/bin/xbvr_data
COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh
ENV XBVR_APPDIR=/config TZ=Asia/Shanghai
EXPOSE 9999 9998
VOLUME ["/config"]
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/usr/bin/xbvr"]
